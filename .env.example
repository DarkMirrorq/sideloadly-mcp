# GitHub Personal Access Token (PAT) for Zero-Mac iOS Cloud Builds (v0.3.0+)
# Required scopes: 'repo' (for private repository creation & push) and 'workflow' (for GitHub Actions macOS builds)
GITHUB_PAT=ghp_your_personal_access_token_here

# Optional: Custom Sideloadly installation folder if not in %LOCALAPPDATA%\Sideloadly
# SIDELOADLY_DIR=C:\Users\YourName\AppData\Local\Sideloadly
